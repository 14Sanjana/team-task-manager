generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(MEMBER)
  tasks     Task[]
  projects  Project[]
  createdAt DateTime  @default(now())
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  createdBy   Int
  creator     User     @relation(fields: [createdBy], references: [id])
  tasks       Task[]
  createdAt   DateTime @default(now())
}

model Task {
  id          Int         @id @default(autoincrement())
  title       String
  description String
  status      TaskStatus  @default(TODO)
  dueDate     DateTime
  assignedTo  Int
  assignee    User        @relation(fields: [assignedTo], references: [id])
  projectId   Int
  project     Project     @relation(fields: [projectId], references: [id])
  createdAt   DateTime    @default(now())
}